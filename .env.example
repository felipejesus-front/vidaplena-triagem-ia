# Copie para .env:   cp .env.example .env
# O .env está no .gitignore. NUNCA faça commit dele.

# ─── Obrigatório ───────────────────────────────────────────────
# Chave da API do Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ─── Opcional ──────────────────────────────────────────────────
# Modelo do Gemini (padrão: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Segredos internos. Deixe em branco: são gerados automaticamente
# na primeira subida pelo serviço secrets-init e guardados num volume Docker.
# Preencha apenas se quiser fixar um valor (ex.: no deploy da VPS).
POSTGRES_PASSWORD=
INTERNAL_API_KEY=
N8N_ENCRYPTION_KEY=
# Senha do admin do n8n (login: admin@vidaplena.example)
N8N_OWNER_PASSWORD=
